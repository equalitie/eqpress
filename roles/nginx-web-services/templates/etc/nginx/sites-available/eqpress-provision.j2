server {
	listen 443 ssl;
        http2 on;
	server_name {{ auto_provision_web_server_name|default(inventory_hostname) }};
	access_log /var/log/nginx/{{ inventory_hostname }}.access.log press_default;
	error_log /var/log/nginx/{{ inventory_hostname }}.error.log;
	root {{ eqpress_root_dir }};

	include /etc/nginx/eqpress-common/common_cdn_realip.conf;
	include /etc/nginx/eqpress-common/common_eqpress_ssl.conf;
	include /etc/nginx/eqpress-common/common_location_ep.conf;

	# Provisioning internals hold plain-text passwords, the node inventory and
	# the playbook/PHP sources: never serve them. ^~ wins over the regex
	# locations above (e.g. the static file allow list that includes .gz).
	location ^~ /ansible/ { deny all; }
	location ^~ /provision/pending/ { deny all; }
	location ^~ /provision/processing/ { deny all; }
	location ^~ /provision/rejected/ { deny all; }
	location ^~ /provision/unencrypted/ { deny all; }
	location ^~ /provision/templates/ { deny all; }
	location ^~ /provision/includes/ { deny all; }

	# Only the gpg-encrypted archives may be downloaded from processed/
	location ^~ /provision/processed/ {
		location ~ \.gpg(-[0-9]+)?$ {
			allow all;
		}
		deny all;
	}

	location / {
		try_files $uri $uri/ /index.php?$args;
	}

	location ~ \.php$ {
            expires 600;
            add_header X-Frame-Options SAMEORIGIN;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_index index.php;
            fastcgi_pass unix:/var/run/php/php{{ php_version }}-fpm-auto-provision.sock;
	}
}
