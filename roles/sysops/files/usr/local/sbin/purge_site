#!/usr/bin/env php
<?php
/**
 * purge_site
 *
 * PHP CLI script to purge a WordPress site from the server.
 * Archives files, nginx config, PHP-FPM pool config, and MySQL database before removal.
 *
 * Usage:
 *   php purge_site <domain> [options]
 */

$domain = $argv[1] ?? null;

if (in_array('--help', $argv) || !$domain || str_starts_with($domain, '--')) {
  echo <<<HELP
Usage:
  php purge_site <domain> [options]

Options:
  --simulate      Show actions without performing them
  --verbose       Output more detailed progress info
  --force-db      Skip DB ownership checks
  --no-backup     Skip archive and DB dump creation
  --yes           Skip confirmation prompt
  --php=<version> Override the detected PHP version (e.g., --php=8.4)
  --help          Show this help message

HELP;
  exit(0);
}

if (!preg_match('/^[a-z0-9.-]+\.[a-z]{2,}$/', $domain)) {
  fwrite(STDERR, "Invalid domain format.\n");
  exit(1);
}

// NOTE: getopt() stops parsing at the first non-option argument. Because the
// domain is positional (argv[1]) and comes before the flags, getopt() would
// discard everything after it (e.g. --simulate). Parse the flags manually.
$flags = array_slice($argv, 1);
$simulate = in_array('--simulate', $flags, true) || in_array('--dry-run', $flags, true);
$verbose  = in_array('--verbose', $flags, true);
$forceDB  = in_array('--force-db', $flags, true);
$noBackup = in_array('--no-backup', $flags, true);
$autoYes  = in_array('--yes', $flags, true);
$phpOverride = null;
foreach ($flags as $flag) {
  if (str_starts_with($flag, '--php=')) {
    $phpOverride = substr($flag, strlen('--php='));
  }
}

$webRoot = "/var/www/{$domain}";
$nginxAvailable = "/etc/nginx/sites-available/{$domain}";
$nginxEnabled = "/etc/nginx/sites-enabled/{$domain}";
$timestamp = date('Ymd_His');
$archiveRoot = "/var/www/archive/{$domain}";
$archiveFile = "{$archiveRoot}/{$domain}-{$timestamp}.tar.gz";
$phpVersion = $phpOverride ?? trim(shell_exec("php -r 'echo PHP_MAJOR_VERSION . \".\" . PHP_MINOR_VERSION;'"));
if (!preg_match('/^\d+\.\d+$/', $phpVersion)) {
  fwrite(STDERR, "Invalid PHP version '{$phpVersion}'.\n");
  exit(1);
}
$phpFpmPool = "/etc/php/{$phpVersion}/fpm/pool.d/{$domain}_pool.conf";

purge_site($domain);

////////////////////////////////////////////////////////////////////////////////
function verbose($message)
{
  global $verbose;
  if ($verbose) echo "[INFO] $message\n";
}

function action($description, callable $callback)
{
  global $simulate;
  verbose($description);
  if ($simulate) {
    echo "[SIMULATE] $description\n";
  } else {
    $callback();
  }
}

function extract_wp_config_value($file, $key)
{
  if (!file_exists($file)) return null;
  $contents = file_get_contents($file);
  if (preg_match("/define\s*\(\s*['\"]{$key}['\"]\s*,\s*['\"]([^'\"]+)['\"]\s*\)/", $contents, $matches)) {
    return $matches[1];
  }
  return null;
}

function archive_site($webRoot, $nginxAvailable, $nginxEnabled, $phpFpmPool, $dbName, $archiveFile, $archiveRoot)
{
  global $noBackup, $simulate;

  if ($noBackup) return;

  action("Creating archive directory", function () use ($archiveRoot) {
    if (!is_dir($archiveRoot)) mkdir($archiveRoot, 0750, true);
  });

  // Stop before anything is deleted if the backup fails
  action("Dumping MySQL database", function () use ($dbName, $archiveRoot) {
    $dumpFile = "$archiveRoot/db.sql.gz";
    $cmd = 'mysqldump -u root ' . escapeshellarg($dbName) . ' | gzip -9 > ' . escapeshellarg($dumpFile);
    system('bash -o pipefail -c ' . escapeshellarg($cmd), $rc);
    if ($rc !== 0) {
      fwrite(STDERR, "Aborting: database dump failed, nothing was deleted.\n");
      exit(1);
    }
  });

  action("Creating site archive", function () use ($webRoot, $nginxAvailable, $nginxEnabled, $phpFpmPool, $archiveFile) {
    $files = array_filter([$nginxAvailable, $nginxEnabled, $phpFpmPool], 'file_exists');
    $cmd = "tar --exclude='*.log' --exclude='*.wpress' --exclude='*/tmp/*' --exclude='*/cache/*' -czf " . escapeshellarg($archiveFile) . ' ';
    $cmd .= implode(' ', array_map('escapeshellarg', $files));
    $cmd .= ' ' . escapeshellarg($webRoot);
    system($cmd, $rc);
    if ($rc !== 0) {
      fwrite(STDERR, "Aborting: site archive failed, nothing was deleted.\n");
      exit(1);
    }
  });
}

// Run mysql with credentials from a temporary 0600 option file, so the
// password never appears on the command line (visible in ps).
function mysql_as($user, $pass, $sql)
{
  $optFile = tempnam(sys_get_temp_dir(), 'purge_site_');
  chmod($optFile, 0600);
  $esc = fn($v) => '"' . str_replace(['\\', '"'], ['\\\\', '\\"'], $v) . '"';
  file_put_contents($optFile, "[client]\nuser=" . $esc($user) . "\npassword=" . $esc($pass) . "\n");
  $out = shell_exec('mysql --defaults-extra-file=' . escapeshellarg($optFile) . ' -e ' . escapeshellarg($sql) . ' 2>&1');
  unlink($optFile);
  return (string) $out;
}

function prompt_confirm($message)
{
  global $autoYes;
  if ($autoYes) return true;

  fwrite(STDOUT, "$message [y/N]: ");
  $handle = fopen("php://stdin", "r");
  $line = strtolower(trim(fgets($handle)));
  return in_array($line, ['y', 'yes']);
}

function purge_site($domain)
{
  global $webRoot, $nginxAvailable, $nginxEnabled, $phpFpmPool, $forceDB, $archiveFile, $archiveRoot, $phpVersion, $noBackup;

  if (!is_dir($webRoot)) {
    fwrite(STDERR, "$domain does not exist.\n");
    exit(1);
  }

  $wpConfig = "$webRoot/wordpress/wp-config.php";
  $dbName = extract_wp_config_value($wpConfig, 'DB_NAME');
  $dbUser = extract_wp_config_value($wpConfig, 'DB_USER');
  $dbPass = extract_wp_config_value($wpConfig, 'DB_PASSWORD');

  if (!$dbName || !$dbUser || !$dbPass) {
    fwrite(STDERR, "Could not extract DB credentials.\n");
    exit(1);
  }

  // wp-config.php is editable by the site: only plain names are used in
  // commands run as root (no override, not even with --force-db).
  foreach (['DB_NAME' => $dbName, 'DB_USER' => $dbUser] as $key => $value) {
    if (!preg_match('/^[A-Za-z0-9_-]{1,64}$/', $value)) {
      fwrite(STDERR, "Aborting: {$key} '{$value}' in {$wpConfig} is not a plain name.\n");
      exit(1);
    }
  }

  $grants = (string) shell_exec('mysql -u root -e ' . escapeshellarg("SHOW GRANTS FOR '{$dbUser}'@'localhost'") . ' 2>&1');
  if (!str_contains($grants, $dbName) && !$forceDB) {
    fwrite(STDERR, "Aborting: DB user does not appear to own DB. Use --force-db to override.\n");
    exit(1);
  }

  $canLogin = mysql_as($dbUser, $dbPass, "USE `{$dbName}`; SELECT 1;");
  if (!str_contains($canLogin, '1') && !$forceDB) {
    fwrite(STDERR, "Aborting: Cannot log in to '{$dbName}' as '{$dbUser}'. Use --force-db to override.\n");
    exit(1);
  }

  // Only delete the Linux account if it is this site's own SFTP account
  $sftpUser = trim((string) shell_exec('/usr/local/sbin/eq_site_sftp_user ' . escapeshellarg($domain) . ' 2>/dev/null'));
  $deleteSystemUser = ($sftpUser !== '' && $sftpUser === $dbUser);
  $sysUserNote = $deleteSystemUser ? $dbUser : "none ('{$dbUser}' is not the SFTP account of {$domain}, kept)";

  echo <<<EOT
You are about to PERMANENTLY delete the following:
- Web root: {$webRoot}
- MySQL database: {$dbName}
- MySQL user: {$dbUser}
- System user: {$sysUserNote}
- Nginx config: {$nginxAvailable}, {$nginxEnabled}
- PHP-FPM pool config: {$phpFpmPool}
EOT;

  if (!$noBackup) {
    echo <<<EOT

An archive will be saved to:
- {$archiveFile}
EOT;
  }

  echo <<<EOT

This cannot be undone.
EOT;

  echo "\n";
  if (!prompt_confirm("Are you sure you want to proceed?")) {
    echo "Aborted.\n";
    exit(0);
  }

  archive_site($webRoot, $nginxAvailable, $nginxEnabled, $phpFpmPool, $dbName, $archiveFile, $archiveRoot);

  action("Dropping MySQL database", fn() => system('mysqladmin --force -u root drop ' . escapeshellarg($dbName)));
  action("Dropping MySQL user", fn() => system('mysql -u root -e ' . escapeshellarg("DROP USER '{$dbUser}'@'localhost'")));
  if ($deleteSystemUser) {
    action("Deleting system user", fn() => system('userdel ' . escapeshellarg($dbUser)));
  } else {
    echo "[INFO] Not deleting system user '{$dbUser}': not the SFTP account of {$domain}.\n";
  }
  action("Deleting nginx config", function () use ($nginxAvailable, $nginxEnabled) {
    @unlink($nginxAvailable);
    @unlink($nginxEnabled);
  });
  action("Delete PHP-FPM pool config", function () use ($phpFpmPool) {
    if (file_exists($phpFpmPool)) {
      @unlink($phpFpmPool);
    }
  });
  action("Deleting webroot", fn() => system('rm -rf -- ' . escapeshellarg($webRoot)));
  action("Reloading nginx", fn() => system("nginx -s reload"));
  action("Reloading PHP-FPM", fn() => system('systemctl reload ' . escapeshellarg("php{$phpVersion}-fpm")));

  echo "Site '{$domain}' purged successfully.\n";
  exit(0);
}
