#!/bin/bash
# {{ ansible_managed }}
#
# monit_console_lockdown.sh
#
# Run as root every 60s by the systemd timer mon_press-console-lockdown
# (timed-jobs). Processes lock and unlock requests that the eqpress console
# writes to {{ eqpress_root_dir }}/console/lockdown/{lock,unlock}/<domain>.
# Those folders are writable by the web server user, so request names are
# treated as untrusted.
#
export PATH=/bin:/usr/bin:/usr/local/sbin
rc=0
LOCKS={{ eqpress_root_dir }}/console/lockdown/lock
UNLOCKS={{ eqpress_root_dir }}/console/lockdown/unlock

# Remove the request and check it names an installed site.
# Prints nothing and returns 0 when the domain is usable.
take_request() {
	local domain=$1
	rm -f -- "$domain"
	if [[ ! "$domain" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
		echo "Error: invalid domain name '$domain', request ignored"
		logger -t eqpress-console "lockdown: ignored request with invalid name '$domain'"
		return 1
	fi
	if [ ! -d "/var/www/$domain/wordpress" ]; then
		echo "Error: $domain is not installed"
		return 1
	fi
	return 0
}

# Run one step of a request; on failure say so and mark the run failed,
# but keep going with the remaining steps.
step() {
	"$@" && return 0
	echo "Error: $* failed"
	rc=1
	return 1
}

if cd "$LOCKS"; then
	for DOMAIN in *; do
		[ -f "$DOMAIN" ] || continue
		take_request "$DOMAIN" || { rc=1; continue; }
		before=$rc; rc=0
		step chcustown "$DOMAIN"	# change ownership to customer's username
		step chepown "/var/www/$DOMAIN" # make all eqpress console files owned by root
		step chwebown "/var/www/$DOMAIN/wordpress/wp-content/uploads" # make uploads writable by web server user
		step chwebown "/var/www/$DOMAIN/wordpress/.sessions" # make PHP sessions dir writable by web server user
		step touch "/var/www/$DOMAIN/wordpress/php-errors.log"
		step chwebown "/var/www/$DOMAIN/wordpress/php-errors.log" # php error log writable by php web server user
		if [ -d "/var/www/$DOMAIN/wordpress/wp-content/blogs.dir" ]; then
			step chwebown "/var/www/$DOMAIN/wordpress/wp-content/blogs.dir" # make multisite upload dir writable by web server user
		fi
		if [ "$rc" -eq 0 ]; then
			echo "$DOMAIN has been locked down"
		else
			echo "Error: lockdown of $DOMAIN did not fully complete"
		fi
		[ "$before" -eq 1 ] && rc=1
	done
else
	echo "Error: Could not change into $LOCKS"
	rc=1
fi

if cd "$UNLOCKS"; then
	for DOMAIN in *; do
		[ -f "$DOMAIN" ] || continue
		take_request "$DOMAIN" || { rc=1; continue; }
		before=$rc; rc=0
		step chwebown "/var/www/$DOMAIN/wordpress" # make everything writable by web server user
		step chepown "/var/www/$DOMAIN" # make eqpress console files owned by root
		if [ "$rc" -eq 0 ]; then
			echo "$DOMAIN has been unlocked"
		else
			echo "Error: unlock of $DOMAIN did not fully complete"
		fi
		[ "$before" -eq 1 ] && rc=1
	done
else
	echo "Error: Could not change into $UNLOCKS"
	rc=1
fi

# 0 = all requests (if any) done; 1 = at least one failed (unit shows failed)
exit $rc
