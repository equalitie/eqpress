#!/bin/bash
# {{ ansible_managed }}
#
# monit_console_perms.sh
#
# Run as root every 60s by the systemd timer mon_press-console-perms
# (timed-jobs). For each request file {{ eqpress_root_dir }}/console/perms/<domain>
# written by the eqpress console, reset that site's ownership to the web
# server user. The folder is writable by the web server user, so request
# names are treated as untrusted.
#
export PATH=/bin:/usr/bin:/usr/local/sbin
CONFS={{ eqpress_root_dir }}/console/perms

cd "$CONFS" || { echo "Error: Could not change into $CONFS"; exit 1; }

rc=0
for DOMAIN in *; do
	[ -f "$DOMAIN" ] || continue
	rm -f -- "$DOMAIN"
	if [[ ! "$DOMAIN" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
		echo "Error: invalid domain name '$DOMAIN', request ignored"
		logger -t eqpress-console "perms: ignored request with invalid name '$DOMAIN'"
		rc=1
		continue
	fi
	if [ -d "/var/www/$DOMAIN/wordpress" ]; then
		if chwebown "/var/www/$DOMAIN/wordpress/" && chepown "/var/www/$DOMAIN"; then
			echo "Changed permissions for: $DOMAIN"
		else
			echo "Error: could not change permissions for $DOMAIN"
			rc=1
		fi
	else
		echo "Error: $DOMAIN is not installed"
		rc=1
	fi
done

# 0 = all requests (if any) done; 1 = at least one failed (unit shows failed)
exit $rc
