#!/bin/bash
# {{ ansible_managed }}
#
# check_mysql_replication_status.sh
#
# Run every 5 minutes by cron on the slave (timed-jobs, eqpress_system_checks).
# Reads this slave's own replication status (as root, via /root/.my.cnf) and
# emails the monitoring address on EVERY run while replication is broken,
# so repeated emails mean it needs action now:
#   PROBLEM  - first detection
#   URGENT   - broken for URGENT_MIN minutes or more
#   CRITICAL - broken for CRITICAL_MIN minutes or more (resync likely needed)
# One OK email is sent when replication recovers.
#
export PATH=/usr/local/bin:/usr/local/sbin:/bin:/usr/bin:/sbin:/usr/sbin

EXPECTED_MASTER_HOST={{ mysql_repl_master }}
EXPECTED_MASTER_PORT=3306
MAX_LAG=300        # seconds behind master before it counts as a problem
URGENT_MIN=15
CRITICAL_MIN=30
EMAIL="{{ monitoring_email }}"
STATE_DIR=/var/lib/eqpress-monitor
SINCE_FILE=$STATE_DIR/replication.since

host=$(hostname -f 2>/dev/null || hostname)
errors=()

# Value of one field from SHOW SLAVE STATUS\G output
field() {
	printf '%s\n' "$status" | sed -n "s/^ *$1: //p" | head -1
}

if ! status=$(mysql -e 'SHOW SLAVE STATUS\G' 2>&1); then
	errors+=("Cannot read slave status: $status")
elif [ -z "$status" ]; then
	errors+=("This server is not configured as a replica (SHOW SLAVE STATUS is empty)")
else
	master_host=$(field Master_Host)
	master_port=$(field Master_Port)
	io_running=$(field Slave_IO_Running)
	sql_running=$(field Slave_SQL_Running)
	lag=$(field Seconds_Behind_Master)
	io_error=$(field Last_IO_Error)
	sql_error=$(field Last_SQL_Error)

	[ "$master_host" != "$EXPECTED_MASTER_HOST" ] && \
		errors+=("Replicating from '$master_host', expected '$EXPECTED_MASTER_HOST'")
	[ "$master_port" != "$EXPECTED_MASTER_PORT" ] && \
		errors+=("Replicating from port '$master_port', expected '$EXPECTED_MASTER_PORT'")
	[ "$io_running" != "Yes" ] && \
		errors+=("Replication IO thread not running ($io_running)${io_error:+: $io_error}")
	[ "$sql_running" != "Yes" ] && \
		errors+=("Replication SQL thread not running ($sql_running)${sql_error:+: $sql_error}")
	if [[ "$lag" =~ ^[0-9]+$ ]]; then
		[ "$lag" -gt "$MAX_LAG" ] && errors+=("Slave is ${lag}s behind the master (limit ${MAX_LAG}s)")
	elif [ "$io_running" = "Yes" ] && [ "$sql_running" = "Yes" ]; then
		errors+=("Seconds_Behind_Master is '$lag'")
	fi
fi

mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
now=$(date +%s)

if [ "${errors[*]}" != "" ]; then
	[ -f "$SINCE_FILE" ] || echo "$now" > "$SINCE_FILE"
	since=$(cat "$SINCE_FILE")
	minutes=$(( (now - since) / 60 ))
	if [ "$minutes" -ge "$CRITICAL_MIN" ]; then
		subject="CRITICAL: replication on $host broken $minutes min - resync likely needed"
	elif [ "$minutes" -ge "$URGENT_MIN" ]; then
		subject="URGENT: replication on $host broken $minutes min"
	else
		subject="PROBLEM: replication on $host ($minutes min)"
	fi
	body=$(printf '%s\n' "${errors[@]}")
	printf '%s\n\nBroken since %s (%s min)\nExpected master: %s:%s\n' \
		"$body" "$(date -d "@$since" '+%F %T %Z')" "$minutes" "$EXPECTED_MASTER_HOST" "$EXPECTED_MASTER_PORT" \
		| mail -s "$subject" -- "$EMAIL"
	logger -t eqpress-monitor "$subject: $(printf '%s; ' "${errors[@]}")"
	exit 1
fi

if [ -f "$SINCE_FILE" ]; then
	since=$(cat "$SINCE_FILE")
	minutes=$(( (now - since) / 60 ))
	subject="OK: replication on $host recovered after $minutes min"
	if printf 'Replication is running again (Seconds_Behind_Master: %s)\n' "$lag" | mail -s "$subject" -- "$EMAIL"; then
		rm -f "$SINCE_FILE"
		logger -t eqpress-monitor "$subject"
	fi
fi
exit 0
