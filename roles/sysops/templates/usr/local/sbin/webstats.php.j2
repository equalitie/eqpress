<?php
/**
 * Log web stats to the database.
 *
 */

ini_set("error_log", "syslog");

$start = microtime( true );

$today = date("Ymd");

include '/usr/local/sbin/class-http-log-parser.php';

$dbh = new mysqli( 'localhost', '{{ mysql_webstats.username }}', '{{ mysql_webstats.password }}', '{{ mysql_webstats.db }}' );
if ( $dbh->connect_error ) {
	printf( "Connect failed: %s: %s\n", $dbh->connect_errno, $dbh->connect_error );
	error_log( "Connect failed: " . $dbh->connect_errno . ": " . $dbh->connect_error );
	exit(1);
}
$shellout = exec( "/bin/ls -1 /var/log/nginx/*.access.log-$today 2>&1", $out, $status );
if ( $status != 0 ) {
	echo "There was a issue collecting webstats today." . PHP_EOL;
	echo "See below:" . PHP_EOL;
	if(count($out)) {
		foreach ($out as $message) {
			echo $message . PHP_EOL;
			error_log($message);
		}
	}
	exit(1);
}
foreach ( $out as $access_log ) {
	$domain = preg_replace( array( '~/var/log/nginx/~sDx', "~\.access\.log\-$today~sDx" ), array( '', '' ), $access_log );
	$hlp = new HTTP_Log_Parser();
	$hlp->set_log( $domain, ".access.log-$today" );
	$stats = $hlp->visitors();
	// DEBUG
	//error_log( http_build_query( $stats ) );
	db_insert_stats( $domain, $stats );
}
$dbh->close();

$end = microtime( true );
$elapsed = $end - $start;
echo('webstats execution time: ' . round( $elapsed, 5 ) . " seconds" );
error_log('webstats execution time: ' . round( $elapsed, 5 ) . " seconds" );
/**
 * Insert the collected stats into the DB. Add the domain if it's not
 * already in the DB.
 *
 */
function db_insert_stats( $domain, $stats ) {
	global $dbh;
	$hits = (int) $stats['hits'];
	$visits = (int) $stats['visits'];
	$visitors = (int) $stats['visitors'];
	$bytes_transfered = (int) $stats['bytes_transfered'];
	$yesterday = time() - ( 60 * 60 * 24 );
	$yymmdd = date( 'Y-m-d', $yesterday );

	// Prepared statements and an exact match: the domain comes from a log
	// file name, and LIKE would treat "_" as a wildcard.
	try {
		$d_id = get_domain_id( $domain );
		if ( $d_id === null ) {
			$stmt = $dbh->prepare( "INSERT INTO domains (`ID`, `domain`) VALUES (NULL, ?)" );
			$stmt->bind_param( 's', $domain );
			$stmt->execute();
			$stmt->close();
			$d_id = get_domain_id( $domain );
		}
		if ( $d_id === null ) {
			error_log( "webstats: could not find or add domain '$domain'" );
			return;
		}
		$stmt = $dbh->prepare( "INSERT INTO stats (`ID`, `date`, `domain_id`, `hits`, `visits`, `unique_visitors`, `bytes_transfered`) VALUES (NULL, ?, ?, ?, ?, ?, ?)" );
		$stmt->bind_param( 'siiiii', $yymmdd, $d_id, $hits, $visits, $visitors, $bytes_transfered );
		$stmt->execute();
		$stmt->close();
	} catch ( Exception $e ) {
		// keep going with the other domains
		echo "webstats: failed for $domain: " . $e->getMessage() . PHP_EOL;
		error_log( "webstats: failed for $domain: " . $e->getMessage() );
	}
}

/**
 * ID of a domain in the domains table, or null if it is not there.
 *
 */
function get_domain_id( $domain ) {
	global $dbh;
	$stmt = $dbh->prepare( "SELECT ID FROM domains WHERE domain = ? LIMIT 1" );
	$stmt->bind_param( 's', $domain );
	$stmt->execute();
	$row = $stmt->get_result()->fetch_row();
	$stmt->close();
	return $row ? (int) $row[0] : null;
}

?>
