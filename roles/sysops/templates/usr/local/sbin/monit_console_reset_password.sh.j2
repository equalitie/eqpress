#!/bin/bash
# {{ ansible_managed }}
#
# monit_console_reset_password.sh
#
# Run as root every 60s by the systemd timer mon_press-reset-password
# (timed-jobs). Processes SFTP password reset requests that the eqpress
# console writes to {{ eqpress_root_dir }}/console/password/<domain>.
#
# That folder is writable by the web server user, so every request is
# treated as untrusted: only the site's own SFTP customer account (primary
# group sftponly, home /var/www/<domain>) can ever be reset.
#
export PATH=/bin:/usr/bin:/usr/sbin:/usr/local/sbin

PASSWD_DIR={{ eqpress_root_dir }}/console/password
SFTPGROUP=sftponly

cd "$PASSWD_DIR" || { echo "Error: could not change into $PASSWD_DIR"; exit 1; }

# Remove a request file without keeping its contents on disk
destroy() {
	shred -zun 100 -- "$1" 2>/dev/null || rm -f -- "$1"
}

reject() {
	local file=$1 reason=$2
	echo "Rejected password reset request '$file': $reason"
	logger -t eqpress-console "rejected SFTP password reset request '$file': $reason"
	destroy "$file"
	rc=1
}

rc=0
for DOMAIN in *; do
	[ -f "$DOMAIN" ] || continue

	# Domain: plain site folder name that exists
	if [[ ! "$DOMAIN" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
		reject "$DOMAIN" "invalid domain name"; continue
	fi
	DOCROOT=/var/www/${DOMAIN}/wordpress
	if [ ! -f "$DOCROOT/wp-config.php" ]; then
		reject "$DOMAIN" "no $DOCROOT/wp-config.php"; continue
	fi
	if [ ! -s "$DOMAIN" ]; then
		reject "$DOMAIN" "empty request file"; continue
	fi

	# SFTP user name comes from DB_USER (as provisioning sets it up).
	# wp-config.php is site-editable, so verify it is that site's SFTP account.
	USER_INFO=($(grep DB_USER "$DOCROOT/wp-config.php" | tr "'" '\n'))
	SFTP_USER=${USER_INFO[3]}
	if [[ ! "$SFTP_USER" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
		reject "$DOMAIN" "invalid DB_USER '$SFTP_USER'"; continue
	fi
	if ! PWENT=$(getent passwd "$SFTP_USER"); then
		reject "$DOMAIN" "user '$SFTP_USER' does not exist"; continue
	fi
	USER_HOME=$(echo "$PWENT" | cut -d: -f6)
	USER_GROUP=$(id -gn "$SFTP_USER")
	if [ "$USER_GROUP" != "$SFTPGROUP" ] || [ "$USER_HOME" != "/var/www/$DOMAIN" ]; then
		reject "$DOMAIN" "user '$SFTP_USER' is not the SFTP account of $DOMAIN (group $USER_GROUP, home $USER_HOME)"; continue
	fi

	# Request file format: <password>'<rampass link>
	set -f
	PASSWDS=($(tr "'" '\n' < "$DOMAIN"))
	set +f
	PASSWORD=${PASSWDS[0]}
	RAMPASS=${PASSWDS[1]}
	if [ -z "$PASSWORD" ]; then
		reject "$DOMAIN" "no password in request"; continue
	fi

	if ! echo "${SFTP_USER}:${PASSWORD}" | chpasswd; then
		reject "$DOMAIN" "chpasswd failed for '$SFTP_USER'"; continue
	fi
	destroy "$DOMAIN"
	logger -t eqpress-console "SFTP password reset for $DOMAIN ($SFTP_USER)"

	# Admin email: wp-cli runs wp-config.php, so run it as that file's owner,
	# never as root.
	OWNER=$(stat -c %U "$DOCROOT/wp-config.php")
	ROOT_FLAG=""
	[ "$OWNER" = "root" ] && ROOT_FLAG="--allow-root"
	EMAIL=$(sudo -u "$OWNER" wp $ROOT_FLAG --path="$DOCROOT" option get admin_email 2>/dev/null)
	# Must look like a single plain address (it is passed to mail)
	if [[ ! "$EMAIL" =~ ^[A-Za-z0-9._%+=\'-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || [[ "$EMAIL" == -* ]]; then
		echo "Reset password for ${DOMAIN}, but admin_email '$EMAIL' is not valid; no email sent"
		logger -t eqpress-console "SFTP password reset for $DOMAIN: invalid admin_email, no email sent"
		rc=1
		continue
	fi

	MESSAGE=$(cat <<EOM
Hi there!

Your SFTP password has been reset via the eqpress Console. You can
get your new password by clicking the following link:

${RAMPASS}

If you did not want your SFTP password reset please contact our support
staff by replying to this email.

Have fun!

The eqpress Team
{{ org_support_email }}
EOM
)
	if ! echo "$MESSAGE" | mail -s "eqpress - SFTP password reset for ${DOMAIN}" -r "eqpress Support <{{ org_support_email }}>" -a "From: eqpress Support <{{ org_support_email }}>" -- "$EMAIL"; then
		echo "Reset password for ${DOMAIN}, but the email to the site admin failed"
		logger -t eqpress-console "SFTP password reset for $DOMAIN: email to admin failed"
		rc=1
		continue
	fi

	echo "Reset password for ${DOMAIN}"
done

# 0 = all requests (if any) done; 1 = at least one failed (unit shows failed)
exit $rc
