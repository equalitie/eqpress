#!/bin/bash
# {{ ansible_managed }}
#
# check_for_large_files.sh
#
# Run every 6 hours by cron on the slave (timed-jobs, eqpress_system_checks).
# Emails a diff whenever the list of files over LIMIT_KB under /var/www
# changes (new big files, removed ones, or size changes).
#
export PATH=/usr/local/bin:/usr/local/sbin:/bin:/usr/bin:/sbin:/usr/sbin

LIMIT_KB=50000
STATE_DIR=/var/lib/eqpress-monitor
current=$STATE_DIR/bigfiles.current
previous=$STATE_DIR/bigfiles.previous

mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
# State files from the old version of this script
rm -f /var/tmp/bigfiles.0 /var/tmp/bigfiles.1

# "<path> - <size>", sorted so the diff only shows real changes
find /var/www -type f -size +"$LIMIT_KB"k -print0 2>/dev/null \
	| while IFS= read -r -d '' f; do
		printf '%s - %s\n' "$f" "$(du -h -- "$f" | cut -f1)"
	done | sort > "$current"

[ -f "$previous" ] || : > "$previous"
dif=$(diff -u "$previous" "$current")
if [ -n "$dif" ]; then
	echo "$dif" | mail -s "Big files exist on $(hostname)" -- {{ monitoring_email }}
fi
mv "$current" "$previous"
