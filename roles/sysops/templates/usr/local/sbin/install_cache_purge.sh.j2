#!/bin/bash
# {{ ansible_managed }}
#
# install_cache_purge.sh <domain|all>
#
# Install (or refresh) the nginx cache purge must-use plugin from
# {{ eqpress_root_dir }}/cache-purge into a site's wp-content/mu-plugins.
# Used by provisioning and deploy_must_use_plugins.sh.
#
# mu-plugins keeps the site's lock state (same owner as its wordpress/
# folder), and eqpress plugin files are made root owned (chepown).
#
export PATH=/usr/local/sbin:/bin:/usr/bin

SOURCE={{ eqpress_root_dir }}/cache-purge
SITES={{ web_user_home }}
WEB_USER={{ web_user }}

mu_install() {
	local site=$1 docroot mu_dir owner
	docroot=$SITES/$site/wordpress
	mu_dir=$docroot/wp-content/mu-plugins
	if [ ! -d "$mu_dir" ]; then
		echo "mu-plugins directory DOES NOT exist for ${site} therefore creating it."
		mkdir -p "$mu_dir" || return 1
	fi
	cp -a "$SOURCE"/. "$mu_dir"/ || return 1

	owner=$(stat -c %U "$docroot")
	if [ "$owner" = "$WEB_USER" ]; then
		# unlocked site: writable by the web server user, as before
		chwebown "$mu_dir"
	else
		# locked down (or not yet handed over): same owner as wordpress/
		chown -R --reference="$docroot" "$mu_dir"
		find "$mu_dir" -type d -print0 | xargs -0 -r chmod 755
		find "$mu_dir" -type f -print0 | xargs -0 -r chmod 644
	fi
	chepown "$SITES/$site"
}

install_all() {
	local docroot site
	for docroot in "$SITES"/*/wordpress; do
		[ -f "$docroot/wp-config.php" ] || continue
		site=$(basename "${docroot%/wordpress}")
		if mu_install "$site"; then
			echo "$site - Success!"
		else
			echo "$site - Installation failed."
		fi
	done
}

if [ -n "$1" ]; then
	if [ "$1" = "all" ]; then
		install_all
		exit 0
	fi
	if [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && [ -d "$SITES/$1/wordpress" ]; then
		mu_install "$1"
		exit $?
	fi
	echo "$1 not a valid domain (e.g. example.com). Should exist under $SITES with a wordpress folder."
	exit 1
fi

echo "No site specified. Should be a domain name like example.com and exist under $SITES"
echo -n "About to install cache-purge for every site. You sure? [y/n] "
read -r ask
if [ "$ask" = "y" ]; then
	install_all
fi
exit 0
